# In development, Vite proxies /api and /socket.io to localhost:4000.
# Set these when the API and Socket.IO server run on another host.
VITE_API_URL=/api
VITE_SOCKET_URL=
# Optional public website origin for shareable office links from local development.
# In production, the client uses its deployed website origin when this is unset.
VITE_PUBLIC_APP_URL=
