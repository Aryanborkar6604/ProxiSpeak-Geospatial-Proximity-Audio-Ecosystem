PORT=4000
NODE_ENV=development
# Required for account registration, password login, and authenticated sessions.
MONGODB_URI=
# Use at least 32 random characters in production; never reuse the development fallback.
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins. In production, add any custom website domains here.
CLIENT_URLS=http://localhost:5173
# User IDs allowed to change persisted office layouts; empty disables layout edits.
OFFICE_ADMIN_USER_IDS=

# Optional coturn-compatible TURN REST configuration.
# Keep the shared secret on the server; never put it in client/.env.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace-with-your-turn-auth-secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional LiveKit SFU. Set all three values to switch voice from peer mesh to LiveKit.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-livekit-api-key
LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret
LIVEKIT_TOKEN_TTL_SECONDS=600
